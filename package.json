{
  "name": "imposia-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node --import tsx scripts/clean-package-dists.ts && tsc -b && node --import tsx scripts/build-core-browser.ts && node --import tsx scripts/build-demo.ts && pnpm site:build && node --import tsx scripts/check-core-package-boundary.ts",
    "build:demo": "node --import tsx scripts/build-demo.ts",
    "site:dev": "cd site && react-router dev",
    "site:build": "cd site && react-router build && cd .. && node --import tsx scripts/check-site-prerender.ts && node --import tsx scripts/copy-site-demo.ts",
    "site:start": "cd site && vite preview",
    "site:typecheck": "cd site && react-router typegen && tsc --noEmit --pretty false -p tsconfig.json",
    "check:core-boundary": "node --import tsx scripts/check-core-package-boundary.ts",
    "setup:browsers": "playwright install chromium firefox webkit",
    "preflight": "node --import tsx scripts/preflight.ts",
    "typecheck": "tsc -b --pretty false && tsc --noEmit --pretty false -p tests/typecheck/tsconfig.json && tsc --noEmit --pretty false -p examples/demo/tsconfig.json && pnpm site:typecheck",
    "lint": "biome check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/core",
    "test:e2e": "playwright test",
    "test:site": "playwright test -c playwright.site.config.ts",
    "test:parity": "playwright test tests/e2e/browser-core-fragmentation.spec.ts tests/e2e/browser-core-breaks.spec.ts",
    "bundle:size": "node --import tsx scripts/bundle-size.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "benchmark:compare": "node --import tsx scripts/benchmark-compare.ts",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "licenses": "node --import tsx scripts/licenses.ts",
    "verify": "node --import tsx scripts/capture-check.ts",
    "check": "pnpm preflight && pnpm typecheck && pnpm lint && pnpm test && pnpm bundle:size && pnpm build && pnpm test:site && pnpm test:e2e && pnpm run audit:prod && pnpm run licenses"
  },
  "devDependencies": {
    "@ampproject/remapping": "2.3.0",
    "@biomejs/biome": "2.5.14",
    "@imposia/react": "workspace:*",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@react-router/node": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "fumadocs-core": "16.15.12",
    "fumadocs-mdx": "15.4.3",
    "fumadocs-ui": "16.15.12",
    "happy-dom": "20.14.5",
    "lucide-react": "1.47.0",
    "oxc-minify": "0.150.0",
    "pdfjs-dist": "6.3.289",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "isbot": "^5"
  }
}
